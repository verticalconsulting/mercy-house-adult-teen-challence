{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "graduate_name": {
      "type": "string",
      "description": "Name of the program graduate"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo URL of the graduate"
    },
    "testimonial_text": {
      "type": "string",
      "description": "The testimonial content"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "mens",
        "womens"
      ],
      "description": "Which program they graduated from"
    },
    "graduation_year": {
      "type": "number",
      "description": "Year they graduated"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Should this testimonial be featured on homepage?"
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Is this testimonial published?"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Additional context or background about the testimonial"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for this graduate's story page, e.g. van-pope. Must be unique."
    },
    "consent_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "The graduate has given written consent for their name, photo and story to be published publicly. Required before the story page will render."
    },
    "consent_date": {
      "type": "string",
      "format": "date",
      "description": "Date written consent was obtained."
    },
    "consent_notes": {
      "type": "string",
      "maxLength": 500,
      "description": "How consent was obtained and where the signed record is filed."
    },
    "shared_to_facebook": {
      "type": "boolean",
      "default": false,
      "description": "Whether this success story has been auto-shared to Facebook"
    },
    "facebook_post_id": {
      "type": "string",
      "description": "Facebook post ID returned after sharing"
    }
  },
  "required": [
    "graduate_name",
    "testimonial_text",
    "program_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}