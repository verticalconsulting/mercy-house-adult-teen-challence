{
  "name": "VehicleDonation",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Donor's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Donor's last name"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "address": {
      "type": "string",
      "description": "Street address where the donation is located"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "zip": {
      "type": "string",
      "description": "ZIP code"
    },
    "donation_type": {
      "type": "string",
      "enum": [
        "car",
        "suv",
        "truck",
        "motorcycle",
        "rv",
        "boat",
        "house",
        "land",
        "other"
      ],
      "default": "car",
      "description": "What is being donated"
    },
    "vehicle_year": {
      "type": "number",
      "description": "Vehicle model year"
    },
    "vehicle_make": {
      "type": "string",
      "description": "Vehicle make (e.g., Toyota, Ford)"
    },
    "vehicle_model": {
      "type": "string",
      "description": "Vehicle model"
    },
    "vehicle_trim": {
      "type": "string",
      "description": "Trim level, usually filled in from the VIN"
    },
    "body_style": {
      "type": "string",
      "description": "Body style, e.g. Sedan, Coupe, SUV or Pickup"
    },
    "engine": {
      "type": "string",
      "description": "Engine size and cylinders, e.g. 3.0L 6-cyl"
    },
    "fuel_type": {
      "type": "string",
      "description": "Fuel type, e.g. Gasoline, Diesel or Electric"
    },
    "drive_type": {
      "type": "string",
      "description": "Drivetrain, e.g. FWD, RWD or AWD"
    },
    "vin": {
      "type": "string",
      "description": "17-character Vehicle Identification Number, when the donor has it"
    },
    "vin_decoded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the vehicle details were filled in from a VIN lookup"
    },
    "vehicle_condition": {
      "type": "string",
      "enum": [
        "running",
        "not_running",
        "needs_repairs"
      ],
      "description": "Vehicle condition"
    },
    "mileage": {
      "type": "number",
      "description": "Odometer reading"
    },
    "title_status": {
      "type": "string",
      "enum": [
        "have_title",
        "no_title",
        "in_process"
      ],
      "description": "Title availability"
    },
    "property_description": {
      "type": "string",
      "description": "Details for a house or land donation"
    },
    "additional_notes": {
      "type": "string",
      "description": "Additional information from the donor"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "scheduled",
        "picked_up",
        "processed",
        "completed"
      ],
      "default": "pending",
      "description": "Donation status"
    },
    "pickup_date": {
      "type": "string",
      "format": "date",
      "description": "Preferred pickup date"
    },
    "pickup_address": {
      "type": "string",
      "description": "Pickup address when it differs from the donation address"
    },
    "sms_consent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the donor agreed to receive text messages about the pickup"
    },
    "estimated_value": {
      "type": "number",
      "description": "Estimated value"
    },
    "pickup_notes": {
      "type": "string",
      "description": "Internal notes about pickup"
    },
    "tax_receipt_sent": {
      "type": "boolean",
      "default": false,
      "description": "Has tax receipt been sent?"
    },
    "gclid": {
      "type": "string",
      "description": "Google Ads click ID from the landing URL"
    },
    "fbclid": {
      "type": "string",
      "description": "Meta click ID from the landing URL"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Additional details about the donation"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}