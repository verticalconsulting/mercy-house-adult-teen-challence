{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Volunteer's full name"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "address": {
      "type": "string",
      "description": "Full address"
    },
    "apartment": {
      "type": "string",
      "description": "Apartment/Unit #"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Volunteer's date of birth"
    },
    "date_available": {
      "type": "string",
      "format": "date",
      "description": "Date the volunteer is available to start"
    },
    "drivers_license_id": {
      "type": "string",
      "description": "Driver's license or ID number"
    },
    "us_citizen": {
      "type": "boolean",
      "description": "Citizen of the United States"
    },
    "volunteered_before": {
      "type": "boolean",
      "description": "Has volunteered with Mercy House before"
    },
    "volunteered_before_when": {
      "type": "string",
      "description": "When they volunteered before"
    },
    "felony_convicted": {
      "type": "boolean",
      "description": "Ever convicted of a felony"
    },
    "felony_explanation": {
      "type": "string",
      "description": "Explanation if convicted of a felony"
    },
    "church_name": {
      "type": "string",
      "description": "Church the volunteer attends"
    },
    "church_attendance_length": {
      "type": "string",
      "description": "How long they have attended"
    },
    "about_yourself": {
      "type": "string",
      "description": "Anything else the volunteer wants to tell us"
    },
    "reference_1_name": {
      "type": "string"
    },
    "reference_1_relationship": {
      "type": "string"
    },
    "reference_1_company": {
      "type": "string"
    },
    "reference_1_phone": {
      "type": "string"
    },
    "reference_2_name": {
      "type": "string"
    },
    "reference_2_relationship": {
      "type": "string"
    },
    "reference_2_company": {
      "type": "string"
    },
    "reference_2_phone": {
      "type": "string"
    },
    "signature": {
      "type": "string",
      "description": "Applicant signature on the disclaimer"
    },
    "signature_date": {
      "type": "string",
      "format": "date"
    },
    "background_signature": {
      "type": "string",
      "description": "Signature on the background information consent"
    },
    "background_signature_date": {
      "type": "string",
      "format": "date"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "preferred_campus": {
      "type": "string",
      "enum": [
        "womens_center",
        "mens_center"
      ],
      "description": "Which campus the volunteer prefers to serve at"
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "weekday_mornings",
          "weekday_afternoons",
          "weekday_evenings",
          "weekends",
          "flexible"
        ]
      },
      "description": "When the volunteer is available"
    },
    "areas_of_interest": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mentoring",
          "teaching",
          "chapel_teaching",
          "ged_prep",
          "administrative",
          "maintenance",
          "events",
          "thrift_store",
          "superthrift",
          "auto_academy",
          "kitchen",
          "childcare",
          "transportation",
          "landscaping",
          "gardening",
          "bee_keeping",
          "chickens",
          "workforce_development"
        ]
      },
      "description": "Areas where volunteer wants to help"
    },
    "skills": {
      "type": "string",
      "description": "Special skills or qualifications"
    },
    "previous_volunteer_experience": {
      "type": "string",
      "description": "Past volunteer experience"
    },
    "why_volunteer": {
      "type": "string",
      "description": "Motivation for volunteering"
    },
    "background_check_consent": {
      "type": "boolean",
      "default": false,
      "description": "Consent to background check"
    },
    "sms_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Whether the volunteer opted in to receive SMS text messages"
    },
    "sms_opt_in_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the volunteer opted in to SMS messaging"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "active",
        "inactive",
        "declined"
      ],
      "default": "pending",
      "description": "Application status"
    },
    "assigned_to": {
      "type": "string",
      "description": "Staff member managing this volunteer"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes from staff"
    },
    "drive_file_id": {
      "type": "string",
      "description": "Google Drive file ID of the formatted volunteer application (.docx)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "When volunteer started"
    }
  },
  "required": [
    "full_name",
    "email",
    "phone",
    "availability",
    "areas_of_interest",
    "background_check_consent"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}